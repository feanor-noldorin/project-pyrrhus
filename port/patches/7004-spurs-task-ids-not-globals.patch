+/* KZ2 patch 7004: the taskset and task id a dispatched task runs as, passed by the caller. They used to travel
+ * through the globals g_ydkj_real_taskset_ea / g_ydkj_real_taskid, which every dispatcher set just before calling
+ * here and which this function copied into the job. The task-exit scan (spu_taskset_task_exited) and
+ * spu_taskset_dispatch set them under the scan lock, but cellSpursCreateTask also writes them outside that lock
+ * (its bridge for YDKJ's cri paths) on another PPU thread, so a CreateTask landing between a scan's write and
+ * this read handed the scan's job the new task's id: the job ran image A's code with task B's TaskInfo (args,
+ * context), its exit cleared task B's bits, and task A stayed enabled and running with nothing behind it. Killzone 2
+ * starts ~450 tasks a second in a level, a third of them from the exit scan, so with the per-task log lines quiet
+ * (KZ2 an earlier change) the overlap was frequent: Gfx.PB.ShadowMap asserted on another task's argument, or the
+ * PPU waited forever for a task that never ran. SPU_TASK_IDS_GLOBAL=1: the old hand-over, for A/B only. */
+static int spu_dispatch_async_ids(const uint8_t* image, uint32_t image_size, uint32_t args_ea,
+                                  uint32_t taskset_ea, uint32_t taskid);
 int spu_workload_dispatch_async(const uint8_t* image, uint32_t image_size,
                                 uint32_t args_ea)
+{
+    /* Callers outside a taskset scan (the old WakeUp policy dispatch, YDKJ's sys_event cri path) keep the
+     * globals: they are the last taskset and task the PPU created, which is what those paths were written for. */
+    extern uint32_t g_ydkj_real_taskset_ea, g_ydkj_real_taskid;
+    return spu_dispatch_async_ids(image, image_size, args_ea, g_ydkj_real_taskset_ea, g_ydkj_real_taskid);
+}
+static int spu_task_ids_global(void)
+{ static int g = -1; if (g < 0) { const char* e = getenv("SPU_TASK_IDS_GLOBAL"); g = (e && e[0] == '1'); } return g; }
+
+static int spu_dispatch_async_ids(const uint8_t* image, uint32_t image_size, uint32_t args_ea,
+                                  uint32_t taskset_ea, uint32_t taskid)
 {
     if (!image || image_size == 0) return 0;
 
@@ -1689,7 +1732,8 @@ int spu_workload_dispatch_async(const uint8_t* image, uint32_t image_size,
      * set the globals for THIS task). Reading them later in the async thread races
      * the next CreateTask overwriting the single-slot globals -- with two audio
      * tasks that made both run task 1's descriptor. */
-    { extern uint32_t g_ydkj_real_taskset_ea, g_ydkj_real_taskid;
+    j->taskset_ea = taskset_ea; j->taskid = taskid;   /* KZ2 patch 7004: the caller's ids, not the globals */
+    if (spu_task_ids_global()) { extern uint32_t g_ydkj_real_taskset_ea, g_ydkj_real_taskid;
       j->taskset_ea = g_ydkj_real_taskset_ea; j->taskid = g_ydkj_real_taskid; }
     /* Mark the task running NOW, not when its thread starts: in that gap another
      * task's exit saw it ready-but-not-running and started it a second time
