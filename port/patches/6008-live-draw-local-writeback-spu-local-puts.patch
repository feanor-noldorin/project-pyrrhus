+/* KZ2 patch 6008: SPU DMA puts into RSX local memory.
+ *
+ * Killzone 2's SPU post-processing chain (WWS jobs Gfx.Post.*) writes its result
+ * into a display buffer in local memory, which the GPU then samples as a
+ * texture (the last draw of a frame copies that buffer into the one it flips).
+ * The SPU write hook (spu_dma.h -> cellGcm_note_guest_write_pages_ea) only
+ * marked pages for the quiet-texture hashing (KZ3 2033), and the band hash of
+ * patch 2017 can miss such a write when the flip baselined the surface after
+ * the SPU had already written it (the walker runs behind the PPU, so an SPU job
+ * kicked for frame N can finish before the walker reaches flip N-1). So SPU puts
+ * into local memory also set bits in a separate 64 KB page bitmap; a surface
+ * bound as a texture or presented consumes the bits under it and uploads those
+ * rows from guest memory (the SPU's bytes win over the GPU's copy).
+ * LD_SPU_LOCAL_UPLOAD=0 disables; LD_SPU_LOCAL_LOG=N logs the first N marks and
+ * N applies. ASSUMPTION: SPU puts into local memory are post output (whole
+ * images); one that lands under a live surface the GPU later redraws before any
+ * bind is uploaded at that bind anyway (the GPU's newer pixels are lost). The
+ * hook runs before the put's copy: a bind on the RSX thread inside that window
+ * would upload the old bytes (the game's own sync, semaphore/command-stream
+ * JUMP, normally keeps the RSX behind the SPU). */
+static volatile LONG g_ld_spu_local[LD_TD_WORDS];
+static volatile LONG g_ld_spu_local_any;
+static volatile LONG g_ld_spu_local_marks, g_ld_spu_local_logged;
+static u32 g_ld_spu_local_applies;
+static int ld_spu_local_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("LD_SPU_LOCAL_UPLOAD"); on = e ? atoi(e) != 0 : 1; }
+    return on;
+}
+static int ld_spu_local_log_n(void)
+{
+    static int n = -1;
+    if (n < 0) { const char* e = getenv("LD_SPU_LOCAL_LOG"); n = e ? atoi(e) : 0; }
+    return n;
+}
+/* Any thread (the SPU write hook). `offset` is a local-memory offset. */
+void rsx_live_draw_note_spu_local_write(u32 offset, u32 size)
+{
+    if (!size || !ld_spu_local_on()) return;
+    const u64 end = (u64)offset + size - 1u;
+    const u32 p0 = offset >> 16, p1 = (u32)(end > 0xFFFFFFFFull ? 0xFFFFFFFFull : end) >> 16;
+    for (u32 p = p0; ; p++) {
+        const LONG bit = (LONG)(1u << (p & 31u));
+        if (!(g_ld_spu_local[p >> 5] & bit)) InterlockedOr(&g_ld_spu_local[p >> 5], bit);
+        if (p == p1) break;
+    }
+    g_ld_spu_local_any = 1;
+    const LONG m = InterlockedIncrement(&g_ld_spu_local_marks);
+    const int ln = ld_spu_local_log_n();
+    if (ln > 0 && (m <= ln || (m & 65535) == 0))
+        fprintf(stderr, "[kz2-spu-local] mark #%ld local 0x%08X +0x%X (frame %u)\n", (long)m, offset, size, g_ld_frames);
+}
+/* RSX thread. Upload the SPU-marked rows of local surface i. Returns 1 if it uploaded. */
+static u32 ld_spu_local_apply(u32 i)
+{
+    if (!g_ld_spu_local_any || i >= g.n_surfaces) return 0;
+    surface_t* s = &g.surfaces[i];
+    u32 texel, gp;
+    if (s->location != 0u || !ld_gv_geometry(s, &texel, &gp)) return 0;
+    const u64 span = (u64)gp * (s->h - 1u) + (u64)s->w * texel;
+    const u32 p0 = s->offset >> 16, p1 = (u32)(((u64)s->offset + span - 1u) >> 16);
+    u32 lo = 0xFFFFFFFFu, hi = 0;
+    for (u32 p = p0; p <= p1 && p < LD_TD_WORDS * 32u; p++) {
+        const LONG bit = (LONG)(1u << (p & 31u));
+        if (g_ld_spu_local[p >> 5] & bit) {
+            InterlockedAnd(&g_ld_spu_local[p >> 5], ~bit);
+            if (lo == 0xFFFFFFFFu) lo = p;
+            hi = p;
+        }
+    }
+    if (lo == 0xFFFFFFFFu) return 0;
+    const u64 b0 = (u64)lo << 16, b1 = ((u64)hi + 1u) << 16;
+    const u32 y0 = b0 <= s->offset ? 0u : (u32)((b0 - s->offset) / gp);
+    u64 y1 = (b1 - s->offset + gp - 1u) / gp;
+    if (y1 > s->h) y1 = s->h;
+    const int ok = ld_gv_upload_rows(s, y0, (u32)y1);
+    if (ok) {
+        if (ld_gv_enabled()) ld_gv_baseline(s);
+        g_ld_spu_local_applies++;
+        const int ln = ld_spu_local_log_n();
+        if (ln > 0 && (g_ld_spu_local_applies <= (u32)ln || (g_ld_spu_local_applies & 1023u) == 0))
+            fprintf(stderr, "[kz2-spu-local] apply #%u surface 0:0x%08X %ux%u rows %u..%u uploaded (frame %u, marks %ld)\n",
+                    g_ld_spu_local_applies, s->offset, s->w, s->h, y0, (u32)y1, g_ld_frames, (long)g_ld_spu_local_marks);
+    }
+    return ok ? 1u : 0u;
+}
