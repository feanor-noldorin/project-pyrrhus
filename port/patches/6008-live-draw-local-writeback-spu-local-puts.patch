+/* KZ2 patch 6008: colour surfaces in LOCAL memory that SPU code reads.
+ * Killzone 2 draws its scene into a local-memory target (0x7B0000 in v1.01,
+ * 0x760000 in 1.29) and hands its EA (0xC0000000 + offset) to the SPU
+ * post-processing chain, which DMAs it from guest memory (RPCS3 needs "Write
+ * color buffers" for the same reason). Patch 2017 wrote back main-memory
+ * surfaces only. LD_LOCAL_WRITEBACK selects local ones too, at the same sync
+ * points (NV4097 0x1D70/0x1D74 releases, NV406E release, flip), at most once per
+ * GPU write (gv_gpu_dirty):
+ *   unset or 0  off;
+ *   1 or auto   every GPU-written local colour surface that is not a registered
+ *               display buffer and has at least LD_LOCAL_WB_MIN_PIXELS pixels
+ *               (default 640*360);
+ *   post        as auto, but only once rsx_live_draw_local_writeback_arm() was
+ *               called (the port calls it when the game's post stage renders):
+ *               a write-back costs a GPU wait (~8 ms per 1280x720 surface in
+ *               Killzone 2), so screens without the SPU chain do not pay it;
+ *   list        comma-separated hex offsets (e.g. 0x760000).
+ * LD_WB_LOG=N logs the first N local write-backs (then every 1024th) with a
+ * non-black count of the guest bytes afterwards (every 16th row).
+ * LD_FAKE_POST=1 (test aid, never in a real run): after a local write-back,
+ * copy the first written-back surface's guest rows into every registered local
+ * display buffer and report the write through the SPU write hook
+ * (cellGcm_note_guest_write_pages_ea), standing in for the SPU post chain. */
+static int g_ld_lwb_mode = -1;   /* 0 off, 1 auto, 2 list, 3 post (auto once armed) */
+static volatile LONG g_ld_lwb_armed;
+void rsx_live_draw_local_writeback_arm(void)
+{
+    if (InterlockedExchange(&g_ld_lwb_armed, 1) == 0)
+        fprintf(stderr, "[kz2-wb] local write-back armed (post stage active, frame %u)\n", g_ld_frames);
+}
+static u32 g_ld_lwb_list[16], g_ld_lwb_n, g_ld_lwb_min = 640u * 360u;
+static int ld_local_wb_mode(void)
+{
+    if (g_ld_lwb_mode < 0) {
+        const char* e = getenv("LD_LOCAL_WRITEBACK");
+        const char* m = getenv("LD_LOCAL_WB_MIN_PIXELS");
+        if (m) g_ld_lwb_min = (u32)strtoul(m, NULL, 0);
+        if (!e || !e[0] || !strcmp(e, "0")) g_ld_lwb_mode = 0;
+        else if (!strcmp(e, "1") || !strcmp(e, "auto")) g_ld_lwb_mode = 1;
+        else if (!strcmp(e, "post")) g_ld_lwb_mode = 3;
+        else {
+            const char* p = e;
+            while (*p && g_ld_lwb_n < 16) {
+                char* end = NULL;
+                const unsigned long v = strtoul(p, &end, 16);
+                if (end == p) break;
+                g_ld_lwb_list[g_ld_lwb_n++] = (u32)v;
+                p = *end == ',' ? end + 1 : end;
+            }
+            g_ld_lwb_mode = g_ld_lwb_n ? 2 : 0;
+        }
+        fprintf(stderr, "[kz2-wb] local-memory surface write-back: %s (min %u pixels, %u listed)\n",
+                g_ld_lwb_mode == 0 ? "off" : g_ld_lwb_mode == 1 ? "auto" : g_ld_lwb_mode == 3 ? "post (auto once armed)" : "list", g_ld_lwb_min, g_ld_lwb_n);
+    }
+    return g_ld_lwb_mode;
+}
+static int ld_local_wb_wanted(const surface_t* sf)
+{
+    const int mode = ld_local_wb_mode();
+    if (!mode || sf->location != 0u) return 0;
+    if (mode == 3 && !g_ld_lwb_armed) return 0;
+    if (mode == 2) {
+        for (u32 k = 0; k < g_ld_lwb_n; k++) if (g_ld_lwb_list[k] == sf->offset) return 1;
+        return 0;
+    }
+    if ((u64)sf->w * sf->h < g_ld_lwb_min) return 0;
+    for (u32 b = 0; b < 8; b++)
+        if (g.display_buffers[b].valid && g.display_buffers[b].location == 0u && g.display_buffers[b].offset == sf->offset)
+            return 0;
+    return 1;
+}
+static void ld_local_wb_report(u32 i)
+{
+    static int cap = -1;
+    static u32 n;
+    if (cap < 0) { const char* e = getenv("LD_WB_LOG"); cap = e ? atoi(e) : 0; }
+    n++;
+    if (cap <= 0 || !(n <= (u32)cap || (n & 1023u) == 0)) return;
+    const surface_t* sf = &g.surfaces[i];
+    u32 texel, gp;
+    u64 nonblack = 0, sampled = 0;
+    if (ld_gv_geometry(sf, &texel, &gp)) {
+        const u8* gm = guest_ptr(sf->location, sf->offset, gp * (sf->h - 1u) + sf->w * texel);
+        for (u32 y = 0; gm && y < sf->h; y += 16)
+            for (u32 x = 0; x < sf->w; x++, sampled++) {
+                const u8* px = gm + (size_t)y * gp + (size_t)x * texel;
+                if (texel == 4 ? (px[1] | px[2] | px[3]) : (px[0] | px[1] | px[2] | px[3] | px[4] | px[5])) nonblack++;
+            }
+    }
+    fprintf(stderr, "[kz2-wb] #%u local 0x%08X %ux%u pitch %u written back (frame %u); guest nonblack %llu/%llu sampled\n",
+            n, sf->offset, sf->w, sf->h, sf->pitch, g_ld_frames, (unsigned long long)nonblack, (unsigned long long)sampled);
+}
+static void ld_fake_post(u32 i)
+{
+    static int on = -1;
