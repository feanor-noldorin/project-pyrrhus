+/* KZ2 patch 6008 (diagnostic): command words the walker reports when it reaches them (cellGcm_watch_cmd_ea). The
+ * Killzone 2 post stage (Render 1.29 0x54B9D0 / v1.01 0x53E930) leaves a word P in the command stream that the PPU
+ * (Render) and the SPU job Gfx.Post.Unlock both overwrite with a JUMP; the port's override registers P here. */
+static volatile u32 s_cw_io[8], s_cw_tag[8], s_cw_last[8];
+static volatile LONG s_cw_n;
+void cellGcm_watch_cmd_ea(u32 ea, u32 tag)
+{
+    const u16 io_page = s_io_address_table[ea >> 20];
+    if (io_page == 0xFFFF) return;
+    const u32 io = ((u32)io_page << 20) | (ea & 0xFFFFFu);
+    const LONG k = InterlockedIncrement(&s_cw_n) - 1;
+    s_cw_io[k & 7] = io; s_cw_tag[k & 7] = tag; s_cw_last[k & 7] = 0xFFFFFFFFu;
+}
+static void gcm_cmd_watch_check(u32 get, u32 w, u32 put)
+{
+    static int cap = -1;
+    static LONG logged;
+    if (cap < 0) { const char* e = getenv("GCM_CMD_WATCH_LOG"); cap = e ? atoi(e) : 64; }
+    for (u32 k = 0; k < 8; k++) {
+        if (s_cw_io[k] != get || s_cw_last[k] == w) continue;
+        s_cw_last[k] = w;
+        if (logged >= cap) return;
+        logged++;
+        const u32 type = w >> 29;
+        fprintf(stderr, "[gcm-watch] tag %u io 0x%08X word 0x%08X %s 0x%08X put 0x%08X\n", s_cw_tag[k], get, w,
+                type == 1 ? ((w & 0x1FFFFFFCu) == get ? "JUMP-self (park) ->" : "JUMP ->") :
+                (w & 3u) == 2u ? "CALL ->" : w == 0x00020000u ? "RET" : "method/data",
+                type == 1 ? (w & 0x1FFFFFFCu) : (w & 3u) == 2u ? (w & ~3u) : 0u, put);
+    }
