+/* KZ3 patch 1039: the per-transfer and per-call hooks below run once per trampoline step and
+ * once per lifted call (~10-12 % of the level's SPU job samples in a KZ3 profile, all out-of-line calls into
+ * functions whose work is mostly env-gated diagnostics). Their common case is now inline; the full bodies
+ * (spu_task_launch_check_full, spu_drain_call_full in spu_drain.c) run whenever a diagnostic env is set, a
+ * pm flow capture targets this context, or KZ3_SPU_FASTCG is below 1039 (then g_spu_launch_diag = 1 and
+ * g_spu_depth_max stays 0, so both inline tests fail without a flag of their own: no extra load per hook). */
+void spu_task_launch_check_full(spu_context* ctx, void* fn); /* SPURS task-launch */
+void spu_check_stack_reset(spu_context* ctx, void (*fn)(spu_context*));
+void spu_launch_ls0_end(spu_context* ctx);
+extern int g_spu_launch_diag;              /* 1: always the full hook (diagnostics or KZ3_SPU_FASTCG < 1039) */
+extern uint32_t g_spu_depth_max;           /* spu_depth_guard's limit, 0 until its first call (or always,
+                                              when KZ3_SPU_FASTCG < 1039) */
+extern volatile unsigned g_spu_stack_reset_n; /* registered stack-reset entries (spu_channels.c) */
+extern void* volatile g_pm_flow_ctx;
+extern volatile int g_yz_lockstep_on;
+static inline __attribute__((always_inline)) void spu_task_launch_check(spu_context* ctx, void* fn)
+{
+    if (__builtin_expect(g_spu_launch_diag | (g_pm_flow_ctx == (void*)ctx), 0)) {
+        spu_task_launch_check_full(ctx, fn);
+        return;
+    }
+    const uint32_t pc = (uint32_t)ctx->pc & SPU_LS_MASK;
+    ctx->recent_pc[ctx->recent_n++ & 31] = pc;
+    if (__builtin_expect(g_spu_stack_reset_n != 0, 0) && ctx->host_depth && !ctx->policy_mode)
+        spu_check_stack_reset(ctx, (void (*)(spu_context*))fn);
+    /* same test as the full hook: a job branching to LS 0 (not on the first step) is complete */
+    if (__builtin_expect(ctx->steps++ && pc == 0, 0) && !ctx->policy_mode && ctx->image_id > 0)
+        spu_launch_ls0_end(ctx);
+}
