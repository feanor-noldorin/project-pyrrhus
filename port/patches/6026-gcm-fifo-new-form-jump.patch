diff --git a/libs/video/gcm_fifo_word.h b/libs/video/gcm_fifo_word.h
new file mode 100644
--- /dev/null
+++ b/libs/video/gcm_fifo_word.h
@@ -0,0 +1,46 @@
+/* KZ2 patch 6026: RSX FIFO control-word decode, in one place for the walker and its diagnostics.
+ *
+ * The RSX command stream has two JUMP encodings. The old one is 0x20000000 | offset (top three bits 001, low two
+ * bits 00, offset in bits 2..28). The new one is offset | 1 (top three bits 000, low two bits 01, offset in bits
+ * 2..31, which the top-bits test limits to below 0x20000000). CALL is offset | 2 and RETURN is 0x00020000. A word
+ * whose low two bits are 01 is never a valid method header (a header's method offset is word-aligned), so a walker
+ * that only knows the old JUMP reads a new-form JUMP as a header with method count (w >> 18) & 0x7FF and walks into
+ * whatever follows it.
+ * Masks as RPCS3's RSX_METHOD_OLD_JUMP_CMD_MASK / RSX_METHOD_NEW_JUMP_CMD_MASK / RSX_METHOD_CALL_CMD_MASK /
+ * RSX_METHOD_RETURN_MASK (rsx_methods.h; read, not copied), as another ps3recomp port also does. */
+#ifndef GCM_FIFO_WORD_H
+#define GCM_FIFO_WORD_H
+
+#include <stdint.h>
+
+#define GCM_OLD_JUMP_MASK    0xE0000003u
+#define GCM_OLD_JUMP_CMD     0x20000000u
+#define GCM_OLD_JUMP_OFFSET  0x1FFFFFFCu
+#define GCM_NEW_JUMP_MASK    0xE0000003u
+#define GCM_NEW_JUMP_CMD     0x00000001u
+#define GCM_NEW_JUMP_OFFSET  0xFFFFFFFCu
+#define GCM_CALL_MASK        0x00000003u
+#define GCM_CALL_CMD         0x00000002u
+#define GCM_CALL_OFFSET      0xFFFFFFFCu
+#define GCM_RETURN_MASK      0xFFFF0003u
+#define GCM_RETURN_CMD       0x00020000u
+
+static inline int gcm_word_is_old_jump(uint32_t w) { return (w & GCM_OLD_JUMP_MASK) == GCM_OLD_JUMP_CMD; }
+static inline int gcm_word_is_new_jump(uint32_t w) { return (w & GCM_NEW_JUMP_MASK) == GCM_NEW_JUMP_CMD; }
+static inline int gcm_word_is_jump(uint32_t w) { return gcm_word_is_old_jump(w) || gcm_word_is_new_jump(w); }
+static inline int gcm_word_is_call(uint32_t w) { return (w & GCM_CALL_MASK) == GCM_CALL_CMD; }
+static inline int gcm_word_is_return(uint32_t w) { return (w & GCM_RETURN_MASK) == GCM_RETURN_CMD; }
+/* JUMP target (either form; the caller has checked gcm_word_is_jump). */
+static inline uint32_t gcm_word_jump_target(uint32_t w)
+{
+    return gcm_word_is_old_jump(w) ? (w & GCM_OLD_JUMP_OFFSET) : (w & GCM_NEW_JUMP_OFFSET);
+}
+static inline uint32_t gcm_word_call_target(uint32_t w) { return w & GCM_CALL_OFFSET; }
+/* A JUMP or CALL (the words the park scans look for as sources). */
+static inline int gcm_word_is_branch(uint32_t w) { return gcm_word_is_jump(w) || gcm_word_is_call(w); }
+static inline uint32_t gcm_word_branch_target(uint32_t w)
+{
+    return gcm_word_is_jump(w) ? gcm_word_jump_target(w) : gcm_word_call_target(w);
+}
+
+#endif
