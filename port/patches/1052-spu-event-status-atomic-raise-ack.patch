diff --git a/runtime/spu/spu_context.h b/runtime/spu/spu_context.h
--- a/runtime/spu/spu_context.h
+++ b/runtime/spu/spu_context.h
@@ -455,6 +455,22 @@ typedef struct spu_context {
 #define SPU_EVENT_CLEAR(c, b) __atomic_fetch_and(&(c)->event_status, ~(uint32_t)(b), __ATOMIC_SEQ_CST)
 #endif
 
+/* KZ3 patch 1052: event_status raises and acks are atomic. Upstream #492 does the same with
+ * SPU_EVENT_SET / SPU_EVENT_CLEAR (taken at every site); these wrappers remain for KZ2 code. The
+ * ready-count and registry parts of 1052 keep KZ3_SPU_RACE_OLD=1 (pre-1052 bare writes, A/B only). */
+static inline int spu_race_old(void)
+{
+    static int s = -1;   /* per TU; read once */
+    if (s < 0) { const char* e = getenv("KZ3_SPU_RACE_OLD"); s = (e && *e == '1') ? 1 : 0; }
+    return s;
+}
+static inline void spu_event_raise(spu_context* ctx, uint32_t bits) { SPU_EVENT_SET(ctx, bits); }
+static inline void spu_event_ack(spu_context* ctx, uint32_t bits)   { SPU_EVENT_CLEAR(ctx, bits); }
+static inline uint32_t spu_event_load(const spu_context* ctx)
+{
+    return __atomic_load_n(&ctx->event_status, __ATOMIC_ACQUIRE);
+}
+
 /* Reserved LS addresses (inside the kernel area, below the 0xA00 policy-module
  * base) that the HLE kernel plants as exitToKernelAddr / selectWorkloadAddr in
  * the SpursKernelContext. A policy module branching to them is performing a
@@ -1063,7 +1079,7 @@ static inline void spu_pchist_tick(const spu_context* ctx)
             if (g_yz_lockstep_on) yz_lockstep_tick(ctx);       \
             spu_task_launch_check((ctx), (void*)_tf);          \
             if ((ctx)->int_enable &&                            \
-                ((ctx)->event_status & (ctx)->event_mask))      \
+                (spu_event_load(ctx) & (ctx)->event_mask))      \
                 _tf = spu_take_interrupt((ctx), _tf);          \
             else if (__builtin_expect(g_spu_irqwait_diag != 0, 0) && \
                      (ctx)->int_enable)                         \
diff --git a/runtime/spu/spu_dma.h b/runtime/spu/spu_dma.h
--- a/runtime/spu/spu_dma.h
+++ b/runtime/spu/spu_dma.h
@@ -1811,6 +1811,22 @@ static inline uint32_t mfc_channel_read(mfc_engine* mfc, spu_context* spu,
 {
     switch (channel) {
     case MFC_RdTagStat:
+        /* KZ3 patch 1052: count "a list is parked at a stall-and-notify element,
+         * its stall is not yet read (list_stall_stat), but SN is not pending":
+         * nothing will ever resume that list (the lost-wakeup signature). With
+         * the atomic event_status writes it must stay 0; the count is printed
+         * at the first hits and every power of two (no env switch: one load and
+         * a test on a path that already reads the tag status). */
+        if (spu->list_stall_stat && (spu->list_stall_mask & spu->mfc_tag_mask) &&
+            !(spu_event_load(spu) & 0x2u)) {
+            static volatile unsigned long s_sn_lost;   /* per TU: spu_channels.c is the reader */
+            unsigned long n = ++s_sn_lost;
+            if (n <= 4 || (n & (n - 1)) == 0)
+                fprintf(stderr, "[sn-lost] n=%lu img=%d pc=0x%05X tagmask=0x%X parked=0x%X "
+                        "sstat=0x%X evstat=0x%X emask=0x%X\n", n, spu->image_id,
+                        spu->pc & SPU_LS_MASK, spu->mfc_tag_mask, spu->list_stall_mask,
+                        spu->list_stall_stat, spu_event_load(spu), spu->event_mask);
+        }
         return spu->mfc_tag_status;
     case MFC_RdTagMask:
         return spu->mfc_tag_mask;
