

Rebased on ps3recomp v0.15.0: partly absorbed, PR290 registry list has no duplicate slots, atomic event_status kept, PR289 machine status taken.

Rebased on ps3recomp v0.18.0 (partly upstream): every event_status raise/ack site takes #492's SPU_EVENT_SET/CLEAR; spu_event_raise/ack kept as wrappers on them; the SPURS ready-count/registry atomics and KZ3_SPU_RACE_OLD kept

diff --git a/libs/spurs/cellSpurs.c b/libs/spurs/cellSpurs.c
--- a/libs/spurs/cellSpurs.c
+++ b/libs/spurs/cellSpurs.c
@@ -2198,7 +2198,13 @@ static DWORD WINAPI spurs_kernel_thread(LPVOID p)
             volatile u8* rdy = vm_base + ea + SPURS_WKL_READY1 + wid;
             u32 sig = vm_read32(ea + SPURS_WKL_SIGNAL1) >> 16;    /* be u16 @0x70 */
             int kicked = (*rdy != 0) || ((sig & (0x8000u >> wid)) != 0);
-            if (*rdy) (*rdy)--;
+            /* KZ3 patch 1052: the PPU updates this guest byte atomically
+             * (cellSpursReadyCountStore/Swap/CompareAndSwap); a bare (*rdy)--
+             * could write back a stale count over a concurrent kick. */
+            if (spu_race_old()) { if (*rdy) (*rdy)--; }
+            else { u8 o = __atomic_load_n(rdy, __ATOMIC_ACQUIRE);
+              while (o && !__atomic_compare_exchange_n(rdy, &o, (u8)(o - 1), 0,
+                                                       __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {} }
             if (sig & (0x8000u >> wid))
                 vm_write32(ea + SPURS_WKL_SIGNAL1,
                            (vm_read32(ea + SPURS_WKL_SIGNAL1) & ~((0x8000u >> wid) << 16)));
