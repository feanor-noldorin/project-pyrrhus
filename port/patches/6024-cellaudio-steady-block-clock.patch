+/* KZ2 patch 6024, test aid: PS3_AUDIO_FAKE_DEVICE=<period ms> stands in for a missing device (muted test runs: the
+ * sandbox has no audio driver) with a buffer of the size WASAPI was asked for (at least three periods) that the
+ * "device" empties by one period of frames at every period boundary, as winepulse asks for data. Nothing is played.
+ * Only when WASAPI found no device: it never replaces a real one. */
+static int       s_fake_period_ms = -1, s_fake_cap, s_fake_fill;
+static long long s_fake_t0, s_fake_done;
+static unsigned long long s_fake_underruns;
+static int audio_fake_on(void)
+{
+    if (s_fake_period_ms < 0) {
+        const char* e = getenv("PS3_AUDIO_FAKE_DEVICE");
+        s_fake_period_ms = e ? atoi(e) : 0;
+        if (s_fake_period_ms < 0 || s_fake_period_ms > 100) s_fake_period_ms = 0;
+        if (s_fake_period_ms) {
+            LARGE_INTEGER c; QueryPerformanceCounter(&c); s_fake_t0 = c.QuadPart;
+            s_fake_cap = (audio_device_paced() ? 20 : 100) * CELL_AUDIO_SAMPLE_RATE / 1000;
+            if (s_fake_cap < 3 * s_fake_period_ms * CELL_AUDIO_SAMPLE_RATE / 1000)
+                s_fake_cap = 3 * s_fake_period_ms * CELL_AUDIO_SAMPLE_RATE / 1000;
+            printf("[cellAudio] PS3_AUDIO_FAKE_DEVICE: no device; a stand-in takes %d frames every %d ms, buffer %d "
+                   "frames\n", s_fake_period_ms * CELL_AUDIO_SAMPLE_RATE / 1000, s_fake_period_ms, s_fake_cap);
+        }
+    }
+    return s_fake_period_ms > 0 && !s_wasapi_client;
+}
+static void audio_fake_update(void)
+{
+    LARGE_INTEGER c, f; long long periods;
+    QueryPerformanceCounter(&c); QueryPerformanceFrequency(&f);
+    periods = (c.QuadPart - s_fake_t0) * 1000 / (f.QuadPart * s_fake_period_ms);
+    while (s_fake_done < periods) {
+        const int take = s_fake_period_ms * CELL_AUDIO_SAMPLE_RATE / 1000;
+        s_fake_done++;
+        if (s_fake_fill < take) { if (s_fake_done > 50) s_fake_underruns++; s_fake_fill = 0; }
+        else s_fake_fill -= take;
+    }
+}
