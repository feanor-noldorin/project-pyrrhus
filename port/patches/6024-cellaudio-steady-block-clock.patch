KZ2 patch 6024: cellAudio consumes port blocks on a steady 5.333 ms clock, not on the device's demand.

Killzone 2's movie audio (intro, AC3 5.1 through 6023) goes through libmixer's cellSurMixer, linked into the EBOOT: its
thread _cellsurMixerMain waits for CELL_AUDIO_EVENT_MIX on a queue of two (0x7B2060), reads the port's read index
(0x7B2148) and writes the next 256 samples AT that index (0x7B21B0, block = index x 8192 bytes, 8 channels), so it has
one block period to run. The mix thread consumed a block whenever the host device had room; under Proton (winepulse)
the device asks for 480 frames every 10 ms, so blocks went out two at a time, the second before the mixer thread could
run: it played as an empty block and the mixer's next write landed on the block after, overwriting the one it had just
written. The game's own port 0 producer writes further ahead, which is why only the movie crackled (hand playtest
2026-10-22). Host test tools/runtime/test_audio_pace.sh models it: the old loop with a 30 ms winepulse-like device gives
5248 empty blocks and 5250 double writes in 11253 blocks; the steady clock none (300 s, device clock +-300 ppm).

Now (libs/audio/audio_pace.h): the PS3 side mixes a block when it is due on the host performance counter, one period
apart whatever the device does, and keeps the device a cushion ahead (40 ms, at most half its buffer; WASAPI is asked
for 100 ms instead of 20). The period is trimmed by up to 5 % from how full the device is, so the two clocks cannot
drift apart (no resampling; the guest sees 5.33 ms +- a few percent); silence fills the cushion at the start and after
the device ran dry. Without a device it is the plain clock, as before. PS3_AUDIO_DEVICE_PACED=1 restores the old loop.
Measure: every port counts dropouts (a single all-zero block between two blocks with sound: audio_hole_track), logged
every 10 s when there were new ones and at PortClose ("port 1 closed after N blocks: K dropouts"). Test aid:
PS3_AUDIO_FAKE_DEVICE=<period ms> stands in for a missing device (muted Proton runs) with winepulse's demand pattern;
it never replaces a real device.

Rebased on ps3recomp v0.18.0 (hand-merged): WASAPI buffer 100 ms on 6024's steady clock, #514's 60 ms with the device-paced loop, #514's PS3_AUDIO_BUF_MS override on both; #514's TIME_CRITICAL/MMCSS mix thread and underrun count kept

diff --git a/libs/audio/audio_pace.h b/libs/audio/audio_pace.h
new file mode 100644
--- /dev/null
+++ b/libs/audio/audio_pace.h
@@ -0,0 +1,100 @@
+/*
+ * KZ2 patch 6024: when cellAudio consumes a port block.
+ *
+ * The PS3 audio system reads one 256-sample block of every running port each 5.333 ms, on its own steady clock,
+ * publishes the new read index and sends CELL_AUDIO_EVENT_MIX. A producer that writes the block AT the published read
+ * index (libmixer's cellSurMixer, linked into Killzone 2 for its movie audio: 0x7B2148 reads the index, 0x7B21B0 writes
+ * the block) has exactly one period to wake and fill it. The mixer used to consume blocks whenever the host device had
+ * room: under Proton (winepulse) the device asks every 10 ms for 480 frames, so blocks went out in bursts of two
+ * back to back, the second before the producer could run. That block played empty (a 5.3 ms hole) and the producer's
+ * next write landed on the block after, overwriting what it had just written: the intro movie's crackle.
+ *
+ * Now the PS3 side ticks on its own clock (the host performance counter, one block per period), whatever the device
+ * does, and the device is kept a cushion ahead: a block that is due is mixed and queued; the period is trimmed by a
+ * few percent from how full the device buffer is, so the two clocks cannot drift apart (no resampling, the guest just
+ * sees periods of 5.33 ms +- a few percent). Without a device (muted runs) it is the plain clock.
+ * Pure arithmetic, no platform calls: tools/runtime/test_audio_pace.c drives it with a simulated device and producer.
+ */
+#ifndef PS3RECOMP_AUDIO_PACE_H
+#define PS3RECOMP_AUDIO_PACE_H
+
+#define AUDIO_PACE_BLOCK      256        /* samples per block (CELL_AUDIO_BLOCK_SAMPLES) */
+#define AUDIO_PACE_RATE       48000      /* Hz */
+#define AUDIO_PACE_LATE_US    50000.0    /* more than this behind: drop the backlog instead of mixing it in a burst */
+#define AUDIO_PACE_GAIN       0.05       /* period trim per unit of relative fill error */
+#define AUDIO_PACE_MAX_TRIM   0.05       /* at most +-5 % */
+
+typedef struct {
+    double period_us;     /* nominal block period, 5333.33 us */
+    double due_us;        /* when the next block is due (host clock) */
+    int    started;
+    int    target;        /* device fill to hold, frames (0 = no device) */
+    unsigned long long blocks;
+    unsigned late_drops;  /* backlogs dropped (the mix thread was stalled) */
+    double late_ms;
+} AudioPace;
+
+static inline void audio_pace_init(AudioPace* p, int target_frames)
+{
+    p->period_us = (double)AUDIO_PACE_BLOCK * 1e6 / (double)AUDIO_PACE_RATE;
+    p->due_us = 0.0;
+    p->started = 0;
+    p->target = target_frames > 0 ? target_frames : 0;
+    p->blocks = 0;
+    p->late_drops = 0;
+    p->late_ms = 0.0;
+}
+
+/* The device cushion for a device buffer of `cap` frames: 40 ms, at most half the buffer, at least two blocks. */
+static inline int audio_pace_target_for(int cap)
+{
+    int t = AUDIO_PACE_RATE / 25;                 /* 1920 frames = 40 ms */
+    if (t > cap / 2) t = cap / 2;
+    if (t < 2 * AUDIO_PACE_BLOCK) t = 2 * AUDIO_PACE_BLOCK;
+    return t;
+}
+
+/* One look at the clock. now_us: host time; fill: frames still queued in the device, -1 without one.
+ * Returns 1 when a block is due (mix it, queue *silence frames of silence first, then the block), else 0 and
+ * *wait_us = how long until it is. *silence is nonzero at the start and when the device ran (nearly) dry, to put the
+ * cushion back. */
+static inline int audio_pace_step(AudioPace* p, double now_us, int fill, double* wait_us, int* silence)
+{
+    double step = p->period_us;
+    *silence = 0;
+    *wait_us = 0.0;
+    if (!p->started) { p->started = 1; p->due_us = now_us; }
+    if (now_us < p->due_us) { *wait_us = p->due_us - now_us; return 0; }
+    if (now_us - p->due_us > AUDIO_PACE_LATE_US) {
+        p->late_drops++;
+        p->late_ms += (now_us - p->due_us) / 1000.0;
+        p->due_us = now_us;
+    }
+    if (fill >= 0 && p->target > 0) {
+        double err, trim;
+        if (fill < AUDIO_PACE_BLOCK) *silence = p->target - fill;
+        err = (double)(fill + *silence - p->target) / (double)p->target;
+        trim = err * AUDIO_PACE_GAIN;
+        if (trim > AUDIO_PACE_MAX_TRIM) trim = AUDIO_PACE_MAX_TRIM;
+        if (trim < -AUDIO_PACE_MAX_TRIM) trim = -AUDIO_PACE_MAX_TRIM;
+        step *= 1.0 + trim;   /* device fuller than the cushion: the next block a little later */
+    }
+    p->due_us += step;
+    p->blocks++;
+    return 1;
+}
+
+/* Dropout count for one port, block by block: a single all-zero block between two blocks with sound is a block the
+ * producer did not fill in time (silence in the material lasts longer than 5.3 ms of exact zeros). */
+typedef struct { unsigned char prev_sound, prev2_sound; unsigned holes; } AudioHoleTrack;   /* zero = start */
+
+static inline int audio_hole_track(AudioHoleTrack* h, int block_has_sound)
+{
+    int hole = !h->prev_sound && h->prev2_sound && block_has_sound;
+    if (hole) h->holes++;
+    h->prev2_sound = h->prev_sound;
+    h->prev_sound = (unsigned char)(block_has_sound != 0);
+    return hole;
+}
+
+#endif
