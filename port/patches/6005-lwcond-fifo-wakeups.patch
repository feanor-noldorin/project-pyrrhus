ppu_sysprx: sys_lwcond waiters in a per-lwcond FIFO, each woken by name (signal: the oldest, signal_all: all queued at
the time, signal_to: that thread). The shared counting semaphore let a thread woken by signal_all re-wait and take a
second count meant for another waiter, which then slept on (FIOS media thread startup hang,
ring traces). General fix, upstream candidate (on top of KZ3 patch 0003).

Rebased on ps3recomp v0.18.0 (hand-merged): FIFO lwcond on #577's slot API (note_block, lwm_release, DWORD tmo, lwm_acquire(ms,0))

diff --git a/runtime/ppu/ppu_sysprx.cpp b/runtime/ppu/ppu_sysprx.cpp
--- a/runtime/ppu/ppu_sysprx.cpp
+++ b/runtime/ppu/ppu_sysprx.cpp
@@ -413,7 +413,23 @@ static void sys_lwmutex_unlock(ppu_context* ctx)
 #define LWC_ID_BASE 0x4C000000u
 #ifdef _WIN32
 #define LWC_SLOTS 8192u
-static struct LwcSlot { HANDLE sem; volatile long waiters; } g_lwc[LWC_SLOTS];
+/* KZ2 patch 6005: each waiter is a node in a per-lwcond FIFO (on the waiter's host stack) and is woken by name. The
+ * old shared counting semaphore let a thread that signal_all had woken, and that went straight back to waiting, take
+ * a second count meant for another waiter: Killzone 2's FIOS scheduler signal_alls its two media threads, one of them
+ * woke twice and the other slept on with its request. lv2 wakes the threads that were
+ * queued at the time of the signal, never one that queued after it. `sem` is kept only as the "created" marker. */
+struct LwcWaiter { struct LwcWaiter* next; uint32_t tid; volatile int woken; };
+static struct LwcSlot { HANDLE sem; volatile long waiters; SRWLOCK lock; CONDITION_VARIABLE cv;
+                        struct LwcWaiter* head; struct LwcWaiter* tail; } g_lwc[LWC_SLOTS];
+static void lwc_unlink(struct LwcSlot* sl, struct LwcWaiter* w)   /* slot lock held */
+{
+    struct LwcWaiter** pp = &sl->head; struct LwcWaiter* prev = nullptr;
+    while (*pp && *pp != w) { prev = *pp; pp = &(*pp)->next; }
+    if (!*pp) return;
+    *pp = w->next;
+    if (sl->tail == w) sl->tail = prev;
+    sl->waiters--;
+}
 static volatile long g_lwc_next = 0;
 static struct LwcSlot* lwc_slot(uint32_t lwcond)
 {
@@ -430,7 +446,7 @@ static void sys_lwcond_create(ppu_context* ctx)
     long n = _InterlockedIncrement(&g_lwc_next);
     if ((uint32_t)n > LWC_SLOTS) { ctx->gpr[3] = (uint64_t)(int64_t)(int32_t)0x80010005u; return; } /* EAGAIN */
     struct LwcSlot* sl = &g_lwc[n - 1];
-    sl->waiters = 0;
+    sl->waiters = 0; sl->head = sl->tail = nullptr;
     if (!sl->sem) sl->sem = CreateSemaphoreA(NULL, 0, 0x7FFFFFFF, NULL);
     uint32_t id = LWC_ID_BASE + (uint32_t)n;
 #else
@@ -505,26 +521,26 @@ static void lwc_trace(const char* what, uint32_t lwcond, ppu_context* ctx, long
     fprintf(stderr, "[LWC] %s ea=0x%08X tid=%llu lr=0x%08X waiters=%ld arg=0x%X\n", what, lwcond,
             ctx ? (unsigned long long)ctx->thread_id : 0ull, ctx ? (uint32_t)ctx->lr : 0u, waiters, arg);
 }
-static void lwcond_wake(uint32_t lwcond, int all)
+static void lwcond_wake(uint32_t lwcond, int all, uint32_t to_tid)
 {
 #ifdef _WIN32
     struct LwcSlot* sl = lwc_slot(lwcond);
     if (!sl || !sl->sem) return;
-    if (all) {
-        long n = _InterlockedExchange(&sl->waiters, 0);
-        if (n > 0) ReleaseSemaphore(sl->sem, n, NULL);
-        return;
-    }
-    for (;;) {
-        long w = sl->waiters;
-        if (w <= 0) return;                         /* nobody waiting: lv2 drops it */
-        if (_InterlockedCompareExchange(&sl->waiters, w - 1, w) == w) {
-            ReleaseSemaphore(sl->sem, 1, NULL);
-            return;
-        }
+    AcquireSRWLockExclusive(&sl->lock);
+    struct LwcWaiter* w = sl->head;
+    if (to_tid)                                     /* signal_to: that thread if it waits, else the oldest */
+        for (struct LwcWaiter* x = sl->head; x; x = x->next) if (x->tid == to_tid) { w = x; break; }
+    while (w) {                                     /* nobody waiting: lv2 drops it */
+        struct LwcWaiter* nx = w->next;
+        lwc_unlink(sl, w);
+        w->woken = 1;
+        if (!all) break;
+        w = nx;
     }
+    ReleaseSRWLockExclusive(&sl->lock);
+    WakeAllConditionVariable(&sl->cv);
 #else
-    (void)lwcond; (void)all;
+    (void)lwcond; (void)all; (void)to_tid;
 #endif
 }
 #ifdef _WIN32
@@ -533,12 +549,12 @@ static void lwcond_wake(uint32_t lwcond, int all)
 #define LWC_WAITERS(ea) (-1L)
 #endif
 static void sys_lwcond_signal(ppu_context* ctx)     { lwc_trace("signal", (uint32_t)ctx->gpr[3], ctx, LWC_WAITERS((uint32_t)ctx->gpr[3]), 0);
-                                                      lwcond_wake((uint32_t)ctx->gpr[3], 0); ctx->gpr[3] = 0; }
+                                                      lwcond_wake((uint32_t)ctx->gpr[3], 0, 0); ctx->gpr[3] = 0; }
 static void sys_lwcond_signal_all(ppu_context* ctx) { lwc_trace("signal_all", (uint32_t)ctx->gpr[3], ctx, LWC_WAITERS((uint32_t)ctx->gpr[3]), 0);
-                                                      lwcond_wake((uint32_t)ctx->gpr[3], 1); ctx->gpr[3] = 0; }
-/* signal_to(lwcond, ppu_thread_id): wakes one waiter; which one is not modelled. */
+                                                      lwcond_wake((uint32_t)ctx->gpr[3], 1, 0); ctx->gpr[3] = 0; }
+/* signal_to(lwcond, ppu_thread_id): wakes that thread if it is waiting, else the oldest waiter (patch 6005). */
 static void sys_lwcond_signal_to(ppu_context* ctx)  { lwc_trace("signal_to", (uint32_t)ctx->gpr[3], ctx, LWC_WAITERS((uint32_t)ctx->gpr[3]), (uint32_t)ctx->gpr[4]);
-                                                      lwcond_wake((uint32_t)ctx->gpr[3], 0); ctx->gpr[3] = 0; }
+                                                      lwcond_wake((uint32_t)ctx->gpr[3], 0, (uint32_t)ctx->gpr[4]); ctx->gpr[3] = 0; }
 static void sys_lwcond_wait(ppu_context* ctx)
 {
     uint32_t lwcond  = (uint32_t)ctx->gpr[3];
@@ -552,25 +568,25 @@ static void sys_lwcond_wait(ppu_context* ctx)
     if (ms && sl && sl->sem) {
         uint32_t own = vm_read32(lwmutex + LWM_OWNER);
         uint32_t rc  = vm_read32(lwmutex + LWM_RECUR);
-        _InterlockedIncrement(&sl->waiters);
+        struct LwcWaiter me = { nullptr, (uint32_t)ctx->thread_id, 0 };
+        AcquireSRWLockExclusive(&sl->lock);         /* queued before the lwmutex drops: no lost signal */
+        if (sl->tail) sl->tail->next = &me; else sl->head = &me;
+        sl->tail = &me; sl->waiters++;
+        ReleaseSRWLockExclusive(&sl->lock);
         vm_write32(lwmutex + LWM_RECUR, 0);
         vm_write32(lwmutex + LWM_OWNER, 0);
         ppu_thread_note_block(ctx->thread_id);
         lwm_release(ms);
-        DWORD tmo = INFINITE;
-        if (timeout_us) { uint64_t m = (timeout_us + 999) / 1000; tmo = m > 0xFFFFFFFEull ? 0xFFFFFFFEu : (DWORD)m; }
-        if (WaitForSingleObject(sl->sem, tmo) == WAIT_TIMEOUT) {
-            /* Withdraw our registration. If a signaller already took it, its
-             * count is on the way: consume it and report the wakeup. */
-            int withdrawn = 0;
-            for (;;) {
-                long w = sl->waiters;
-                if (w <= 0) break;
-                if (_InterlockedCompareExchange(&sl->waiters, w - 1, w) == w) { withdrawn = 1; break; }
-            }
-            if (withdrawn) result = 0x8001000Bu;
-            else WaitForSingleObject(sl->sem, INFINITE);
+        ULONGLONG deadline = timeout_us ? GetTickCount64() + (timeout_us + 999) / 1000 : 0;
+        AcquireSRWLockExclusive(&sl->lock);
+        while (!me.woken) {
+            DWORD tmo = INFINITE;
+            if (deadline) { ULONGLONG now = GetTickCount64(); if (now >= deadline) break;
+                            tmo = (DWORD)((deadline - now) > 0xFFFFFFFEull ? 0xFFFFFFFEu : (deadline - now)); }
+            SleepConditionVariableSRW(&sl->cv, &sl->lock, tmo, 0);
         }
+        if (!me.woken) { lwc_unlink(sl, &me); result = 0x8001000Bu; }   /* timed out, not signalled */
+        ReleaseSRWLockExclusive(&sl->lock);
         lwm_acquire(ms, 0);
         vm_write32(lwmutex + LWM_OWNER, own);
         vm_write32(lwmutex + LWM_RECUR, rc ? rc : 1);
