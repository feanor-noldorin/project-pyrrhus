+/* KZ2 patch 4020: which bound keys went down this poll, for the prompt-device switch (KZ2 4016 took the edge from
+ * the held state of the previous poll). While the window is not in front (or the bindings page captures keys) the
+ * keys read as up; the first poll back in front takes the keys held at that moment as the baseline instead of as
+ * presses. A key already down when the window comes back (the click that brought it to the front, a key the overlay
+ * or the desktop kept held across a focus change, as around Steam's F12 screenshot) is not a press made in the game,
+ * and it switched the prompts to keycaps once per focus change (hand session 2026-10-22: six switches, all on R1's
+ * binding, Mouse1 / O; F12 itself is unbound and never counted). Starts in the baseline state, so a key held while
+ * the game starts does not count either. */
+typedef struct { PadKbState held; int baseline; } PadKbEdge;
+
+static inline void pad_kb_edge_init(PadKbEdge* e) { e->held.buttons = 0; e->held.dirs = 0; e->baseline = 1; }
+
+static inline PadKbState pad_kb_edge(PadKbEdge* e, int in_front, PadKbState now)
+{
+    PadKbState fresh = { 0, 0 };
+    if (!in_front) { e->held = fresh; e->baseline = 1; return fresh; }
+    if (e->baseline) { e->baseline = 0; e->held = now; return fresh; }
+    fresh.buttons = (unsigned short)(now.buttons & ~e->held.buttons);
+    fresh.dirs = (unsigned char)(now.dirs & ~e->held.dirs);
+    e->held = now;
+    return fresh;
+}
+
+/* KZ2 patch 4020: the names of the held keys behind the inputs in `st` ("r1:Mouse1 cross:Space"), for the log. */
+static inline void pad_kb_names(const PadKeybinds* kb, PadKbState st, PadKbDown down, void* ctx, char* buf, size_t n)
+{
+    size_t o = 0;
+    int i, s;
+    if (n) buf[0] = 0;
+    for (i = 0; i < PKB_N_INPUTS; i++) {
+        int hit = pad_kb_inputs[i].dir >= 0 ? (st.dirs >> pad_kb_inputs[i].dir) & 1 : (st.buttons & pad_kb_inputs[i].btn) != 0;
+        if (!hit) continue;
+        for (s = 0; s < PKB_SLOTS; s++)
+            if (kb->key[i][s] && down(ctx, kb->key[i][s])) {
+                int w = snprintf(buf + o, o < n ? n - o : 0, "%s%s:%s", o ? " " : "", pad_kb_inputs[i].name,
+                                 pad_kb_key_name(kb->key[i][s]));
+                if (w > 0) o += (size_t)w;
+                if (o >= n) return;
+                break;
+            }
+    }
+}
+
