diff --git a/libs/input/pad_motion_stick.h b/libs/input/pad_motion_stick.h
new file mode 100644
--- /dev/null
+++ b/libs/input/pad_motion_stick.h
@@ -0,0 +1,60 @@
+/*
+ * pad_motion_stick.h -- SIXAXIS stick fallback (KZ2 port patch 4015; ENHANCEMENT).
+ *
+ * Killzone 2 turns valves and arms demolition charges by tilting the pad (SIXAXIS). It reads the motion words
+ * (CellPadData.button[20..23]) only when the pad reports the PRESS_MODE capability and len > 20, and both the valve
+ * (ValveJoystickController @0x00127210) and the charge (ExplosiveLocationJoystickController @0x00119C90) use only
+ * the roll  atan(-X / sqrt(Y^2 + Z^2))  of the low-passed, centred words. Both read the grab buttons
+ * GrabLeftHand/GrabRightHand (EDeviceFunction 20/21, L1/R1; @0x00127120 and @0x00119B88), and the valve only turns
+ * while both are held. A pad with no motion sensor reports the rest values, so the roll never changes and these
+ * sections cannot be finished.
+ *
+ * The fallback: while L1 and R1 are both held on a pad without motion sensors, the right stick's X tilts the pad,
+ *     X = 512 + 113 * tan(36 deg * s),  s = right stick X in [-1, 1],  Y = 399 (1 g), Z = 512, G = 512,
+ * so full deflection is a 36 deg roll: inside the valve's +-35 deg hand clamp and inside the charge's arm windows
+ * (33.4..37.3 deg of +-45 on each side). Anything else sends the rest values. Only L1+R1 together, never one
+ * shoulder alone: L1 (zoom) also reads roll and pitch for the SIXAXIS aim correction (@0x00171698), which must
+ * stay as it was. A pad with real sensors keeps its own data. KZ2_MOTION_STICK=0 turns the fallback off.
+ * ASSUMPTION: the sign (stick right = positive X) was not checked against a real DS3; both directions are used
+ * by the valves and the charge, so it does not decide whether they work.
+ *
+ * Pure: no SDL, no OS call; tools/runtime/test_motion_stick.c tests it on the host.
+ */
+#ifndef PS3RECOMP_PAD_MOTION_STICK_H
+#define PS3RECOMP_PAD_MOTION_STICK_H
+
+#include <math.h>
+#include "cellPad.h"
+
+#define PMS_REST_X 512
+#define PMS_REST_Y 399   /* 1 g on Y: 113 words per g below 512, a DS3 lying flat */
+#define PMS_REST_Z 512
+#define PMS_REST_G 512
+#define PMS_WORDS_PER_G 113.0f
+#define PMS_MAX_DEG 36.0f
+
+/* Stick byte (0..255, 128 centre) to [-1, 1], both ends reachable (PAD_SCRIPT's -1 -> 0, +1 -> 255). */
+static inline float pms_stick_unit(u8 v)
+{
+    float s = v >= 128 ? (float)(v - 128) / 127.0f : (float)(v - 128) / 128.0f;
+    return s < -1.0f ? -1.0f : s > 1.0f ? 1.0f : s;
+}
+
+/* The four motion words (X, Y, Z, G) one poll sends. has_sensor/real = the host pad's own sensor words (4010),
+ * buttons = the CELL_PAD_CTRL_* mask the game sees this poll, rx = right stick X byte, enabled = KZ2_MOTION_STICK
+ * is not 0. A pad with sensors sends its own words; without, the rest values, or the stick tilt while L1+R1 are
+ * both held. Returns 1 when the stick tilt applies. */
+static inline int pad_motion_words(int enabled, int has_sensor, const u16 real[4], u16 buttons, u8 rx, u16 out[4])
+{
+    if (has_sensor) { out[0] = real[0]; out[1] = real[1]; out[2] = real[2]; out[3] = real[3]; return 0; }
+    out[0] = PMS_REST_X; out[1] = PMS_REST_Y; out[2] = PMS_REST_Z; out[3] = PMS_REST_G;
+    const u16 both = (u16)(CELL_PAD_CTRL_L1 | CELL_PAD_CTRL_R1);
+    if (!enabled || (buttons & both) != both) return 0;
+    const float rad = PMS_MAX_DEG * pms_stick_unit(rx) * 0.017453293f;
+    float w = (float)PMS_REST_X + PMS_WORDS_PER_G * tanf(rad);
+    w += w >= 0.0f ? 0.5f : -0.5f;
+    out[0] = (u16)(w < 0.0f ? 0 : w > 1023.0f ? 1023 : (int)w);
+    return 1;
+}
+
+#endif /* PS3RECOMP_PAD_MOTION_STICK_H */
