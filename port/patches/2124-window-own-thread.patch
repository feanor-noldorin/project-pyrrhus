+/* Patch 2124: the window's own thread (see the block at the top). */
+static void rsx_null_title_tick(void);
+static struct { u32 w, h; const char* title; int rc; HANDLE ready; } s_wt_args;
+
+static void rsx_wt_gap_note(double gap_ms, LARGE_INTEGER now, LARGE_INTEGER qf)
+{
+    static LARGE_INTEGER s_win;
+    static double s_max;
+    static unsigned s_n, s_long, s_lines;
+    if (!s_win.QuadPart) s_win = now;
+    s_n++;
+    if (gap_ms > s_max) s_max = gap_ms;
+    if (gap_ms > 250.0) {
+        s_long++;
+        if (s_lines++ < 20) fprintf(stderr, "[wpump] window thread: gap %.0f ms between message checks\n", gap_ms);
+    }
+    const double win = (double)(now.QuadPart - s_win.QuadPart) / (double)qf.QuadPart;
+    if (win >= 10.0) {
+        fprintf(stderr, "[wpump] window thread: last %.1f s: %u message checks, longest gap %.0f ms, %u gap(s) over 250 ms\n",
+                win, s_n, s_max, s_long);
+        s_win = now; s_n = s_long = 0; s_max = 0.0;
+    }
+}
+
+static DWORD WINAPI rsx_window_thread(LPVOID p)
+{
+    (void)p;
+    s_wt_args.rc = null_create_window(s_wt_args.w, s_wt_args.h, s_wt_args.title);
+    SetEvent(s_wt_args.ready);
+    if (s_wt_args.rc != 0) return 0;
+    LARGE_INTEGER qf, last, now;
+    QueryPerformanceFrequency(&qf);
+    QueryPerformanceCounter(&last);
+    for (;;) {
+        MsgWaitForMultipleObjects(0, NULL, FALSE, 50, QS_ALLINPUT);
+        QueryPerformanceCounter(&now);
+        rsx_wt_gap_note((double)(now.QuadPart - last.QuadPart) * 1e3 / (double)qf.QuadPart, now, qf);
+        MSG msg;
+        while (PeekMessageA(&msg, NULL, 0, 0, PM_REMOVE)) {
+            if (msg.message == WM_QUIT) { s_state.window_closed = 1; return 0; }
+            TranslateMessage(&msg);
+            DispatchMessageA(&msg);
+        }
+        if (s_dm_pending == RSX_DM_FULLSCREEN && !s_dm_wait) rsx_dm_apply(RSX_DM_FULLSCREEN, "start");
+        rsx_dm_script_step();
+        rsx_null_title_tick();
+        QueryPerformanceCounter(&last);
+    }
+}
+
+int rsx_null_backend_init(u32 width, u32 height, const char* title)
+{
+    const char* e = getenv("KZ2_WINDOW_THREAD");
+    s_wt_on = !(e && e[0] == '0');
+    printf("[RSX null] window %s\n", s_wt_on ? "on its own thread (KZ2_WINDOW_THREAD=0 = on the frame thread)"
+                                              : "on the frame thread (KZ2_WINDOW_THREAD=0)");
+    if (!s_wt_on) return null_create_window(width, height, title);
+    s_wt_args.w = width; s_wt_args.h = height; s_wt_args.title = title; s_wt_args.rc = -1;
+    s_wt_args.ready = CreateEventA(NULL, TRUE, FALSE, NULL);
+    HANDLE th = s_wt_args.ready ? CreateThread(NULL, 1u << 20, rsx_window_thread, NULL, 0, NULL) : NULL;
+    if (!th) {
+        printf("[RSX null] window thread not started (%lu): window on the frame thread\n", GetLastError());
+        s_wt_on = 0;
+        return null_create_window(width, height, title);
+    }
+    WaitForSingleObject(s_wt_args.ready, INFINITE);
+    CloseHandle(th);
+    return s_wt_args.rc;
+}
