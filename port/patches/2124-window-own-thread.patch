+
+/* Patch 2124: the frame thread's answer to a swap-chain request, on the window's thread. */
+static void rsx_dm_fs_done(int stage, int r)
+{
+    const char* why = s_dm_wait_why;
+    s_dm_wait = 0;
+    if (stage == RSX_WT_FS_LEAVE) rsx_dm_apply_window(s_dm_wait_m, why);
+    else if (stage == RSX_WT_FS_ENTER) rsx_dm_fs_result(r, why);
+    else if (r > 0) rsx_dm_log_client("exclusive fullscreen taken back on activation");
+    if (!s_dm_wait && s_dm_next_m >= 0) {
+        const int m = s_dm_next_m;
+        s_dm_next_m = -1;
+        rsx_dm_apply(m, s_dm_next_why);
+    }
+}
