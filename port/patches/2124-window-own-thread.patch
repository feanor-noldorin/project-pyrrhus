+/* The rest of a change to exclusive fullscreen, once rsx_live_draw_set_fullscreen(1) answered r. */
+static void rsx_dm_fs_result(int r, const char* why)
+{
+    int m = RSX_DM_FULLSCREEN;
+    if (r < 0 && s_present_suppressed) {           /* live draw not up yet: retry at the next pump */
+        s_dm_pending = RSX_DM_FULLSCREEN;
+        s_dm_applied = RSX_DM_BORDERLESS;
+        rsx_dm_log_client("exclusive fullscreen waits for the swap chain");
+        return;
+    }
+    s_dm_pending = -1;
+    if (r <= 0) {
