+        printf("[display] exclusive fullscreen refused (%s): borderless for this session\n",
+               r < 0 ? "no live-draw swap chain" : "SetFullscreenState failed");
+    }
+    s_dm_applied = m;
+    rsx_dm_log_client(why);
