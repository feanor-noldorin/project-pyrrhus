         fi = -1;
     if (fi > 0 && in->wpos_aa && ld_wpos_aa_apply(ps_hlsl, ps_sz, in->wpos_aa) < 0)   /* KZ2 patch 2088 */
         fi = -1;
+    if (fi > 0 && ld_deriv_scale_apply(ps_hlsl, ps_sz, in->wpos_aa, in->deriv_flip) < 0)   /* KZ2 patch 2096 */
+        fi = -1;
     if (fi > 0 && srgb_out && rsx_fp_apply_srgb_output(ps_hlsl, ps_sz) < 0) {   /* patch 2055 */
         static int said; if (!said++) fprintf(stderr, "[srgb-out] apply failed: PSO left linear\n");
     }
@@ -8361,6 +8396,7 @@ static u64 ld_pso_key_tail(u64 key, const ld_xl_in* xi, int packed_payload, u64*
                        key = fnv1a(&xi->wpos_aa, sizeof xi->wpos_aa, key); }
     if (xi->wpos_flip) { const u32 tag = 0x57504F00u | 0x46u; key = fnv1a(&tag, sizeof tag, key);   /* KZ2 patch 2090 */
                          key = fnv1a(&xi->wpos_flip, sizeof xi->wpos_flip, key); }
+    if (xi->deriv_flip) { const u32 tag = 0x44445900u | 0x46u; key = fnv1a(&tag, sizeof tag, key); }   /* KZ2 patch 2096 */
     if (masked_layout) {
         static const u32 masked_layout_tag = 0x314B534Du; /* "MSK1" */
         const u32 payload_stride =
@@ -8443,7 +8479,8 @@ static void ld_pt_note(u64 key, const ld_xl_in* xi, int packed, int depth)
     r->shadow_mask = xi->shadow_mask; r->argb_mask = xi->argb_mask; r->unnorm_mask = xi->unnorm_mask;
     r->flags = RSX_PT_FLAG_BUFFERED | (xi->layout ? RSX_PT_FLAG_LAYOUT : 0u) | (xi->layout && packed ? RSX_PT_FLAG_PACKED : 0u) |
                (depth ? RSX_PT_FLAG_DEPTH : 0u) |
-               ((xi->wpos_aa & 0xFFFFu) << RSX_PT_WPOS_AA_SHIFT);   /* KZ2 patch 2088 */
+               ((xi->wpos_aa & 0xFFFFu) << RSX_PT_WPOS_AA_SHIFT) |   /* KZ2 patch 2088 */
+               (xi->deriv_flip ? RSX_PT_FLAG_DDY_FLIP : 0u);          /* KZ2 patch 2096 */
     if (xi->layout) {
         r->layout_mask = xi->layout->mask; r->layout_stride = xi->layout->stride; r->layout_count = xi->layout->count;
         memcpy(r->attrs, xi->layout->attrs, sizeof r->attrs);
@@ -8558,6 +8595,7 @@ static void ld_pt_build(u32 ri, char* vs_hlsl, char* ps_hlsl, rsx_fp_constant_bl
     xi.vp_branch_bits_used = rsx_vp_uses_branch_bits(vp->bytes, r->vp_instrs * 16); xi.vp_branch_bits = 0;
     /* KZ2 patch 2088: the walker keys pipelines of antialiased targets by their sample grid; the record carries it. */
     xi.wpos_aa = ld_wpos_aa_on() ? (r->flags >> RSX_PT_WPOS_AA_SHIFT) & 0xFFFFu : 0u;
+    xi.deriv_flip = (r->flags & RSX_PT_FLAG_DDY_FLIP) && ld_ddy_origin_on() ? 1u : 0u;   /* KZ2 patch 2096 */
     u64 key = r->key;
     int packed = (r->flags & RSX_PT_FLAG_PACKED) != 0;
     {   /* the record's key must be what the walker derives from these programs and this state */
@@ -9718,6 +9756,9 @@ static ID3D12PipelineState* get_pso(
         rsx_dsp_get_surface(&g.rsx, &wsf);
         if (wsf.aa_sx != 1u || wsf.aa_sy != 1u) xi.wpos_aa = wsf.aa_sx | (wsf.aa_sy << 8);
