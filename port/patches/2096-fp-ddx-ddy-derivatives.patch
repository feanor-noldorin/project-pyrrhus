+    xi.deriv_flip = 0;   /* KZ2 patch 2096 */
+    if (ld_ddy_origin_on() && ((rsx_dsp_reg(&g.rsx, 0x1D88) >> 12) & 0xFu) == 1u && rsx_fp_uses_ddy(fp_uc, fp_size))
+        xi.deriv_flip = 1;
     xi.wpos_flip = 0;   /* KZ2 patch 2090 */
