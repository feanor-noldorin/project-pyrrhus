+/* KZ2 patch 2096: DDX / DDY in pixels of the RSX's window.
+ *
+ * The decompiler emits DDX as ddx(v) * _rsx_deriv_scale.x and DDY as ddy(v) * _rsx_deriv_scale.y, (1, 1) in its text.
+ * Two things differ between the RSX and the D3D12 pipeline the program runs in:
+ *  - an antialiased target is kept at its sample resolution (patch 2088), so a D3D derivative spans one sample where
+ *    the RSX's spans one pixel: scale by the samples per pixel (aa_sx, aa_sy);
+ *  - on a bottom-origin shader window (0x1D88 bits 12-15 = 1) the RSX's window y grows upwards (WPOS.y = height - y,
+ *    patch 2090) while SV_Position y grows downwards, so DDY changes sign.
+ * The sample grid is already in every pipeline key (2088); the DDY sign is keyed as deriv_flip, only for programs that
+ * use DDY on a bottom-origin window. LD_DDY_ORIGIN=0 keeps DDY unsigned by the origin (for an A/B).
+ * ASSUMPTION: the RSX's DDY follows its window y (as WPOS does); Killzone 2's menu panels take |DDX| + |DDY|, so their
+ * picture does not depend on it. */
+static int ld_ddy_origin_on(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char* e = getenv("LD_DDY_ORIGIN");
+        on = e ? atoi(e) != 0 : 1;
+        fprintf(stderr, "[fp-deriv] DDY follows the shader window's origin: %s\n", on ? "on" : "off (LD_DDY_ORIGIN=0)");
+    }
+    return on;
+}
+static int ld_deriv_scale_apply(char* hlsl, size_t size, u32 wpos_aa, u32 flip)
+{
+    const u32 ax = wpos_aa & 0xFFu, ay = (wpos_aa >> 8) & 0xFFu;
+    const float sx = ax > 1u ? (float)ax : 1.0f, sy = (ay > 1u ? (float)ay : 1.0f) * (flip ? -1.0f : 1.0f);
+    const int r = rsx_fp_set_deriv_scale(hlsl, (u32)size, sx, sy);
+    static u32 logs;
+    if (r > 0 && logs++ < 8) fprintf(stderr, "[fp-deriv] program with DDX/DDY: scale (%.0f, %.0f)\n", sx, sy);
+    return r;
+}
 static void ld_xlate(const ld_xl_in* in, char* vs_hlsl, size_t vs_sz, char* ps_hlsl, size_t ps_sz, int* vi_out, int* fi_out)
