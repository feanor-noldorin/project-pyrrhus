gcm/live-draw: fragment DDX and DDY (screen-space derivatives) are decompiled; LD_DDY_ORIGIN=0 old DDY sign.

Symptom (Killzone 2, every menu page): the panels, the list's selection bar, the header bars, the difficulty and
collectible icons and the mission picture on Mission Select are missing; only text, button glyphs and the opaque
black frame behind the mission picture draw. The selected entry is therefore not highlighted, and Mission Select
shows a black box where the picture should be.

Cause: the panels' fragment program takes an anti-aliased edge factor from the screen-space derivative of its
texture coordinate, min(uv - uv^2, fwidth(uv)) / fwidth(uv) with fwidth = |DDX| + |DDY| (Killzone 2 1.29, program
at loc 1 0x00115480 in the Statistics page, frame 2609 of kz2-r41-ui1), and multiplies the alpha by it. The decompiler
had no case for DDX (0x15) or DDY (0x16): it emitted a TODO comment and wrote nothing, so the destination kept 0, the
factor became 0 * (1 / 0) = NaN and the export guard returned a transparent 0. Every panel, bar and picture that
uses the program blended away.

Fix: DDX emits ddx(v) * _rsx_deriv_scale.x and DDY ddy(v) * _rsx_deriv_scale.y; a program that uses either gets the
declaration static const float2 _rsx_deriv_scale = float2(1.0, 1.0); in its preamble (other programs' text is
unchanged). The live-draw rewrites the scale per pipeline: an antialiased target is kept at its sample resolution
(patch 2088), so a derivative spans one sample where the RSX's spans a pixel (scale by the samples per pixel); and on
a bottom-origin shader window (0x1D88 bits 12-15 = 1) the RSX's window y grows upwards (patch 2090), so DDY is
negated. The sample grid is already in every pipeline key (2088); the DDY sign is keyed (deriv_flip) only for
programs that use DDY on a bottom-origin window, and the prewarm template carries it as RSX_PT_FLAG_DDY_FLIP.
"[fp-deriv]" logs the first programs and the switch. ASSUMPTION: the RSX's DDY follows its window y as WPOS does
(Killzone 2's panels take |DDX| + |DDY|, so their picture does not depend on the sign).
DDX/DDY are the NV40 fragment ops for the screen-space partial derivatives (opcode numbers as in the decompiler's
table). Written for this port; no third-party code read for it. Host test: tools/runtime/test_fp_deriv.sh. Upstream candidate (any title: DDX/DDY are
general NV40 ops).

Rebased on ps3recomp v0.18.0: context and offsets only.

diff --git a/libs/video/rsx_fp_decompiler.c b/libs/video/rsx_fp_decompiler.c
--- a/libs/video/rsx_fp_decompiler.c
+++ b/libs/video/rsx_fp_decompiler.c
@@ -691,6 +691,38 @@ int rsx_fp_reads_wpos(const u8* ucode, u32 max_bytes)
     return 0;
 }
 
+/* KZ2 patch 2096: does any instruction take a screen-space derivative (DDY)? The same walk as above. DDX needs no
+ * state beyond the target's sample grid, which every pipeline key already carries (patch 2088). */
+int rsx_fp_uses_ddy(const u8* ucode, u32 max_bytes)
+{
+    if (!ucode) return 0;
+    for (u32 off = 0; off + 16 <= max_bytes;) {
+        const u32 w0 = rsx_fp_read_word(ucode + off);
+        const u32 w1 = rsx_fp_read_word(ucode + off + 4);
+        const u32 w2 = rsx_fp_read_word(ucode + off + 8);
+        const u32 w3 = rsx_fp_read_word(ucode + off + 12);
+        if (!(w2 & FP_BRANCH) && ((w0 & FP_OPCODE_MASK) >> FP_OPCODE_SHIFT) == OP_DDY) return 1;
+        off += 16;
+        if (!(w2 & FP_BRANCH) && ((w1 & 3u) == 2 || (w2 & 3u) == 2 || (w3 & 3u) == 2)) off += 16;
+        if (w0 & FP_END) return 0;
+    }
+    return 0;
+}
+
+int rsx_fp_set_deriv_scale(char* hlsl, u32 hlsl_size, float sx, float sy)
+{
+    if (!hlsl) return 0;
+    char* at = strstr(hlsl, RSX_FP_DERIV_SCALE_DECL);
+    if (!at) return 0;
+    char rep[128];
+    const int rl = snprintf(rep, sizeof rep, "static const float2 _rsx_deriv_scale = float2(%.1f, %.1f);", sx, sy);
+    const size_t kl = sizeof RSX_FP_DERIV_SCALE_DECL - 1, len = strlen(hlsl);
+    if (rl <= 0 || (size_t)rl >= sizeof rep || len - kl + (size_t)rl + 1 > hlsl_size) return -1;
+    memmove(at + rl, at + kl, len - (size_t)(at - hlsl) - kl + 1);
+    memcpy(at, rep, (size_t)rl);
+    return 1;
+}
+
 static void fp_expand_helper(Out* out)
 {
     out_puts(out,
@@ -845,6 +877,7 @@ static int rsx_fp_decompile_internal(
     Out o = { out, out_size, 0, 1 };
     out[0] = '\0';
     int uses_pack = 0;   /* a pack or unpack opcode was decoded: the preamble gets its helpers */
+    int uses_deriv = 0;  /* KZ2 patch 2096: DDX or DDY was decoded: the preamble declares _rsx_deriv_scale */
     out_puts(&o,
         /* 64 each: the source and destination register fields are 6 bits
          * (FP_SRC_REG_MASK / FP_OUT_REG_MASK). 48 rejected every program
@@ -1098,6 +1131,13 @@ static int rsx_fp_decompile_internal(
         case OP_FRC: snprintf(rhs, sizeof(rhs), "frac(%s)", a); break;
         case OP_FLR: snprintf(rhs, sizeof(rhs), "floor(%s)", a); break;
         case OP_RCP: snprintf(rhs, sizeof(rhs), "(1.0 / (%s).x)", a); break;
+        /* KZ2 patch 2096: screen-space derivatives. Unhandled, they wrote nothing, so the destination kept 0 and
+         * a program dividing by fwidth (Killzone 2's anti-aliased menu panels: min(uv - uv^2, fwidth) / fwidth)
+         * produced NaN, which the export guard turns into a transparent 0. _rsx_deriv_scale is (1, 1) in the
+         * decompiler's text; the live-draw rewrites it per pipeline for the target's sample grid and the shader
+         * window's origin (rsx_fp_set_deriv_scale). */
+        case OP_DDX: uses_deriv = 1; snprintf(rhs, sizeof(rhs), "(ddx(%s) * _rsx_deriv_scale.x)", a); break;
+        case OP_DDY: uses_deriv = 1; snprintf(rhs, sizeof(rhs), "(ddy(%s) * _rsx_deriv_scale.y)", a); break;
         /* Pack/unpack (RPCS3 FragmentProgramDecompiler PK/UP cases and the pkg/upg
          * builtins): the packed word is a scalar that replicates. */
         case OP_PK4UB: uses_pack = 1; snprintf(rhs, sizeof(rhs), "asfloat(_rsx_pk4ub(%s))", a); break;
@@ -1522,6 +1562,7 @@ static int rsx_fp_decompile_internal(
      * decompiler skipped, leaving the destination with whatever it held.
      * Only for a program that uses one, so every other program's text is
      * unchanged. */
+    if (uses_deriv) out_puts(&p, RSX_FP_DERIV_SCALE_DECL "\n");   /* KZ2 patch 2096 */
     if (uses_pack) out_puts(&p,
         "uint   _rsx_pk4ub(float4 v) { uint4 b = (uint4)round(saturate(v) * 255.0); return b.x | (b.y << 8) | (b.z << 16) | (b.w << 24); }\n"
         "float4 _rsx_up4ub(float v) { uint u = asuint(v); return float4(u & 255u, (u >> 8) & 255u, (u >> 16) & 255u, (u >> 24) & 255u) / 255.0; }\n"
