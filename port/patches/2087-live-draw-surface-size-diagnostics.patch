     if (slot != LD_INVALID_SURFACE) g.surfaces[slot].pitch = sf.color_pitch[0];
+    if (slot != LD_INVALID_SURFACE && ld_alias_size_log_n()) {   /* KZ2 patch 2087 diagnostic: draws into aliased targets */
+        u32 n_at = 0;
