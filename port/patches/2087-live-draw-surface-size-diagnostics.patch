+        static u64 seen[128]; static u32 n_seen, logged;
+        const u32 fmt = rsx_dsp_reg(&g.rsx, 0x0208), vph = rsx_dsp_reg(&g.rsx, 0x0A00), sch = rsx_dsp_reg(&g.rsx, 0x08C0);
+        const u64 key = ((u64)slot << 56) ^ ((u64)fmt << 24) ^ (u64)vph ^ ((u64)sch << 12) ^ ((u64)sf.color_pitch[0] << 40);
+        int dup = 0;
+        for (u32 k = 0; k < n_seen; k++) if (seen[k] == key) dup = 1;
+        if ((n_at >= 2 || sf.aa_sx != 1u || sf.clip_w > g.width) && !dup && logged < (u32)ld_alias_size_log_n()) {
+            if (n_seen < 128) seen[n_seen++] = key;
+            logged++;
+            fprintf(stderr, "[alias-size] f=%u target slot %u %u:0x%08X clip %ux%u aa %ux%u pitch %u surface-format 0x%08X "
+                    "viewport-h 0x%08X scissor-h 0x%08X clip-h 0x%08X\n", g_ld_frames, slot, sf.color_location[0],
+                    sf.color_offset[0], sf.clip_w, sf.clip_h, sf.aa_sx, sf.aa_sy, sf.color_pitch[0], fmt, vph, sch,
+                    rsx_dsp_reg(&g.rsx, 0x0200));
+        }
+    }
     return slot;
 }
 
