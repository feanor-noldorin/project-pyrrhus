+/* KZ2 patch 2087 diagnostic (LD_ALIAS_SIZE_LOG=N, off by default): surfaces are keyed on (address, size, format)
+ * (surface_get), so one address can hold several live surfaces of different sizes. Log the texture binds and the
+ * presents that resolve to a live surface of another size than declared, or of an address that holds two or more
+ * live surfaces: declared size and format, the draw's target, the surface picked and every candidate with its
+ * generations (create / last draw). One line per new (what, address, declared size, target, pick), at most N lines. */
+static int ld_alias_size_log_n(void)
+{
+    static int n = -1;
+    if (n < 0) { const char* e = getenv("LD_ALIAS_SIZE_LOG"); n = e ? atoi(e) : 0; }
+    return n;
+}
+static void ld_alias_size_note(const char* what, u32 location, u32 offset, u32 tw, u32 th, u32 tfmt, u32 tpitch,
+                               u32 target, int picked)
+{
+    const int cap = ld_alias_size_log_n();
+    static int logged;
+    static u64 seen[512];
+    static u32 n_seen;
+    if (logged >= cap) return;
+    u32 n_at = 0;
+    for (u32 i = 0; i < g.n_surfaces; i++)
+        if (g.surfaces[i].tex && g.surfaces[i].location == location && g.surfaces[i].offset == offset) n_at++;
+    const int mismatch = picked >= 0 && (u32)picked < g.n_surfaces &&
+                         (g.surfaces[picked].w != tw || g.surfaces[picked].h != th);
+    u32 n_tat = 0;   /* surfaces at the draw target's address */
+    if (target < g.n_surfaces)
+        for (u32 i = 0; i < g.n_surfaces; i++)
+            if (g.surfaces[i].tex && g.surfaces[i].location == g.surfaces[target].location &&
+                g.surfaces[i].offset == g.surfaces[target].offset) n_tat++;
+    if (n_at < 2 && !mismatch && n_tat < 2) return;
+    const u64 key = ((u64)offset << 32) ^ ((u64)tw << 20) ^ ((u64)th << 8) ^ ((u64)(target & 0xFFu) << 48) ^
+                    (u64)(u32)(picked + 2) ^ ((u64)(what[0]) << 56) ^ ((u64)(tfmt & 0xFFu) << 40);
+    for (u32 k = 0; k < n_seen; k++) if (seen[k] == key) return;
+    if (n_seen < 512) seen[n_seen++] = key;
+    logged++;
+    char buf[512]; int k = 0;
+    for (u32 i = 0; i < g.n_surfaces && k < (int)sizeof(buf) - 96; i++) {
+        const surface_t* sf = &g.surfaces[i];
+        if (!sf->tex || sf->location != location || sf->offset != offset) continue;
+#if !defined(YZ_PERF_CLEAN)
+        k += snprintf(buf + k, sizeof(buf) - (size_t)k, " [%u]%ux%u fmt%d create=%u draw=%u", i, sf->w, sf->h,
+                      (int)sf->fmt, sf->last_create_generation, sf->last_draw_generation);
+#else
+        k += snprintf(buf + k, sizeof(buf) - (size_t)k, " [%u]%ux%u fmt%d", i, sf->w, sf->h, (int)sf->fmt);
+#endif
+    }
+    const surface_t* tg = target < g.n_surfaces ? &g.surfaces[target] : NULL;
+    fprintf(stderr, "[alias-size] f=%u %s%s %u:0x%08X fmt=0x%02X %ux%u pitch=%u target=%d(%u:0x%X %ux%u) -> %d;%s\n",
+            g_ld_frames, what, mismatch ? " SIZE-MISMATCH" : "", location, offset, tfmt, tw, th, tpitch,
+            tg ? (int)target : -1, tg ? tg->location : 0u, tg ? tg->offset : 0u, tg ? tg->w : 0u, tg ? tg->h : 0u,
+            picked, buf);
+}
