+/* KZ2 patch 2090: WPOS honours the shader window's origin.
+ *
+ * NV4097_SET_SHADER_WINDOW (0x1D88): height in bits 0-11, origin in bits 12-15 (0 = top, 1 = bottom), pixel centre in
+ * bits 16-19. With the origin at the bottom the RSX hands the fragment program WPOS.y = height - y (y counted from the
+ * top, as SV_Position counts it); RPCS3 does the same with its wpos_scale -1 / wpos_bias height fragment constants.
+ * The decompiler always handed out SV_Position, so a program on a bottom-origin window that addresses a screen-space
+ * texture from WPOS read it upside down. Fix: in such a program every read of input.position becomes
+ * float4(p.x, height - p.y, p.zw) (applied before 2088, so 2088's per-pixel centre is taken first). Keyed only for
+ * programs that read WPOS on a bottom-origin window. LD_WPOS_ORIGIN=0 = old behaviour. The first 64 distinct
+ * (window, target) pairs of WPOS-reading draws are logged as [wpos-origin] either way.
+ * ASSUMPTION: the pixel-centre field (half/integer) is still ignored, as before. */
+static int ld_wpos_origin_on(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char* e = getenv("LD_WPOS_ORIGIN");
+        on = e ? atoi(e) != 0 : 1;
+        fprintf(stderr, "[wpos-origin] WPOS.y from the bottom on bottom-origin shader windows: %s\n",
+                on ? "on" : "off (LD_WPOS_ORIGIN=0)");
+    }
+    return on;
+}
+static int ld_wpos_flip_apply(char* hlsl, size_t size, u32 height)
+{
+    if (!hlsl || !height) return 0;
+    static const char key[] = "input.position";
+    char rep[200];
+    snprintf(rep, sizeof rep, "float4(input.position.x, %u.0 - input.position.y, input.position.zw)", height);
+    const size_t kl = sizeof key - 1, rl = strlen(rep);
+    size_t n = 0;
+    for (const char* p = strstr(hlsl, key); p; p = strstr(p + kl, key)) n++;
+    if (!n) return 0;
+    const size_t len = strlen(hlsl), need = len + n * (rl - kl) + 1;
+    if (need > size) return -1;
+    char* out = (char*)malloc(need);
+    if (!out) return -1;
+    char* o = out; const char* p = hlsl;
+    for (const char* q = strstr(p, key); q; q = strstr(p, key)) {
+        memcpy(o, p, (size_t)(q - p)); o += q - p;
+        memcpy(o, rep, rl); o += rl;
+        p = q + kl;
+    }
+    strcpy(o, p);
+    memcpy(hlsl, out, need);
+    free(out);
+    static u32 logs;
+    if (logs++ < 8) fprintf(stderr, "[wpos-origin] %u WPOS read(s) flipped (window height %u)\n", (u32)n, height);
+    return (int)n;
+}
