KZ2 patch 2122: the Keyboard page's host rows (pad_kb_rows, KZ3 patch 2038's command interface)
in the KZ2 page's order. The KZ2 page (port/kz2/kz2_menu_text.h KB_INPUTS, from tools/re/kbpage.py) lists the inputs
in keybinds.ini order (pad_kb_inputs: up, down, left, right, cross, ... select, then ls_up .. rs_right), while 2038's
rows were KZ3's page order (ls_up first). Every "key R S", "dup R S", "capture R S", "clear R S" and "sel R S" from
the KZ2 page therefore named another input: row 0 "D-PAD UP" showed ls_up's W, and a capture there rebound Move
forward (kz2-r47-m6: 'key 0 0' -> 'W', test key J -> row 0 = ls_up). The rows are now pad_kb_inputs' order; the
labels (capture hint and conflict text) follow their rows. Host test tools/runtime/test_kb_rows.sh checks
pad_kb_rows = pad_kb_inputs = KB_INPUTS.

diff -ruN a/libs/input/pad_keybinds.h b/libs/input/pad_keybinds.h
--- a/libs/input/pad_keybinds.h	2026-10-27 17:32:19.932085474 -0500
+++ b/libs/input/pad_keybinds.h	2026-10-27 17:32:19.947578894 -0500
@@ -486,19 +486,23 @@
  * player's language and active preset); `label` is the port's own fallback (file comments, host tests) and
  * the page text for the eight stick directions and Start, which have no string of their own in the game. */
 typedef struct { const char* input; const char* label; const char* button; } PadKbRow;
+/* KZ2 patch 2122: the rows in the KZ2 page's order, which is pad_kb_inputs' (the keybinds.ini order: 16 buttons, then
+ * the 8 stick directions; port/kz2/kz2_menu_text.h KB_INPUTS, tools/re/kbpage.py). KZ3's order (sticks first, the
+ * KZ3 GUM's) made the KZ2 page show and capture the wrong input: its row 0 "D-PAD UP" answered "key 0 0" with
+ * ls_up's W, and a capture there rebound Move forward (run kz2-r47-m6). */
 static const PadKbRow pad_kb_rows[] = {
+    { "up", "Up", "Up" },                 { "down", "Down", "Down" },
+    { "left", "Left", "Left" },           { "right", "Right", "Right" },
+    { "cross", "Jump", "Cross" },         { "circle", "Use", "Circle" },
+    { "square", "Reload", "Square" },     { "triangle", "Next weapon", "Triangle" },
+    { "l1", "Melee", "Shoulder_Left_1" }, { "r1", "Fire", "Shoulder_Right_1" },
+    { "l2", "Crouch", "Shoulder_Left_2" }, { "r2", "Grenade", "Shoulder_Right_2" },
+    { "l3", "Sprint", "Left_Analog" },    { "r3", "Zoom", "Right_Analog" },
+    { "start", "Pause", 0 },              { "select", "Objectives", "Select" },
     { "ls_up", "Move forward", 0 },       { "ls_down", "Move back", 0 },
     { "ls_left", "Strafe left", 0 },      { "ls_right", "Strafe right", 0 },
     { "rs_up", "Look up", 0 },            { "rs_down", "Look down", 0 },
     { "rs_left", "Turn left", 0 },        { "rs_right", "Turn right", 0 },
-    { "r1", "Fire", "Shoulder_Right_1" }, { "r3", "Zoom", "Right_Analog" },
-    { "square", "Reload", "Square" },     { "triangle", "Next weapon", "Triangle" },
-    { "cross", "Jump", "Cross" },         { "circle", "Use", "Circle" },
-    { "l2", "Crouch", "Shoulder_Left_2" }, { "l3", "Sprint", "Left_Analog" },
-    { "l1", "Melee", "Shoulder_Left_1" }, { "r2", "Grenade", "Shoulder_Right_2" },
-    { "up", "Up", "Up" },                 { "down", "Down", "Down" },
-    { "left", "Left", "Left" },           { "right", "Right", "Right" },
-    { "start", "Pause", 0 },              { "select", "Objectives", "Select" },
 };
 #define PKB_N_ROWS ((int)(sizeof pad_kb_rows / sizeof pad_kb_rows[0]))
 
