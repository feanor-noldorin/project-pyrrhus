+/* KZ2 patch 6019: label-release wake (cellGcmSys.h). The notifier is lock-free unless a waiter is registered. */
+#ifdef _WIN32
+static volatile LONG s_label_seq = 0, s_label_waiters = 0;
+static SRWLOCK s_label_lock = SRWLOCK_INIT;
+static CONDITION_VARIABLE s_label_cv = CONDITION_VARIABLE_INIT;
+u32 cellGcm_label_seq(void) { return (u32)InterlockedCompareExchange(&s_label_seq, 0, 0); }
+void cellGcm_label_notify(void)
+{
+    InterlockedIncrement(&s_label_seq);
+    if (InterlockedCompareExchange(&s_label_waiters, 0, 0) != 0) {
+        AcquireSRWLockExclusive(&s_label_lock);
+        ReleaseSRWLockExclusive(&s_label_lock);
+        WakeAllConditionVariable(&s_label_cv);
+    }
+}
+void cellGcm_label_wait_seq(u32 seq, u32 timeout_ms)
+{
+    AcquireSRWLockExclusive(&s_label_lock);
+    InterlockedIncrement(&s_label_waiters);
+    if ((u32)InterlockedCompareExchange(&s_label_seq, 0, 0) == seq)
+        SleepConditionVariableSRW(&s_label_cv, &s_label_lock, timeout_ms, 0);
+    InterlockedDecrement(&s_label_waiters);
+    ReleaseSRWLockExclusive(&s_label_lock);
+}
+#else
+#include <pthread.h>
+#include <stdatomic.h>
+static atomic_uint s_label_seq = 0, s_label_waiters = 0;
+static pthread_mutex_t s_label_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t s_label_cv = PTHREAD_COND_INITIALIZER;
+u32 cellGcm_label_seq(void) { return atomic_load(&s_label_seq); }
+void cellGcm_label_notify(void)
+{
+    atomic_fetch_add(&s_label_seq, 1);
+    if (atomic_load(&s_label_waiters) != 0) {
+        pthread_mutex_lock(&s_label_lock);
+        pthread_cond_broadcast(&s_label_cv);
+        pthread_mutex_unlock(&s_label_lock);
+    }
+}
+void cellGcm_label_wait_seq(u32 seq, u32 timeout_ms)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_REALTIME, &ts);
+    ts.tv_sec += timeout_ms / 1000u;
+    ts.tv_nsec += (long)(timeout_ms % 1000u) * 1000000L;
+    if (ts.tv_nsec >= 1000000000L) { ts.tv_sec++; ts.tv_nsec -= 1000000000L; }
+    pthread_mutex_lock(&s_label_lock);
+    atomic_fetch_add(&s_label_waiters, 1);
+    if (atomic_load(&s_label_seq) == seq) pthread_cond_timedwait(&s_label_cv, &s_label_lock, &ts);
+    atomic_fetch_sub(&s_label_waiters, 1);
+    pthread_mutex_unlock(&s_label_lock);
+}
+#endif
